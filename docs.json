{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "The Drive AI",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/introduction",
              "getting-started/quick-start",
              "getting-started/interface-overview"
            ]
          },
          {
            "group": "The Agent",
            "pages": [
              "agent/overview",
              "agent/connected-drives",
              "agent/browser-extension"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/overview"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/uploading-files",
              "features/pdf-tools",
              "features/e-sign",
              "features/document-creation",
              "features/document-scanning",
              "features/file-sharing",
              "features/file-requests",
              "features/security"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/google-drive",
              "integrations/onedrive",
              "integrations/dropbox",
              "integrations/email-integration",
              "integrations/slack",
              "integrations/microsoft-teams",
              "integrations/mcp-server"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/plans-pricing",
              "account/members-and-roles"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/faq",
              "help/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Developer API",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "developer/introduction",
              "developer/quickstart",
              "developer/schemas"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "developer/analyze",
              "developer/decide",
              "developer/cross-analyze",
              "developer/webhooks"
            ]
          },
          {
            "group": "Extraction",
            "pages": [
              "POST /api/v1/extract",
              "POST /api/v1/extract/batch"
            ]
          },
          {
            "group": "Analysis",
            "pages": [
              "POST /api/v1/analyze",
              "POST /api/v1/analyze/cross",
              "POST /api/v1/analyze/batch"
            ]
          },
          {
            "group": "Decision",
            "pages": [
              "POST /api/v1/decide"
            ]
          },
          {
            "group": "Utilities",
            "pages": [
              "POST /api/v1/markdown/convert",
              "POST /api/v1/thumbnails/generate"
            ]
          },
          {
            "group": "Jobs & Webhooks",
            "pages": [
              "GET /api/v1/jobs/{task_id}",
              "GET /api/v1/jobs/batch/{batch_id}",
              "GET /api/v1/jobs/{task_id}/deliveries"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://thedrive.ai",
          "icon": "globe"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.com/invite/mCnxKxyxPC",
          "icon": "discord"
        },
        {
          "anchor": "MCP Server",
          "href": "https://thedrive.ai/mcp",
          "icon": "plug"
        },
        {
          "anchor": "Android App",
          "href": "https://play.google.com/store/apps/details?id=com.bigyankarki.thedriveai&referrer=utm_source%3Ddocs%26utm_medium%3Ddocs%26utm_campaign%3Dandroid_launch",
          "icon": "android"
        },
        {
          "anchor": "iOS App",
          "href": "https://apps.apple.com/us/app/the-drive-ai-file-organizer/id6758524851",
          "icon": "apple"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/features/chat-mode",
      "destination": "/agent/overview"
    },
    {
      "source": "/features/agent-mode",
      "destination": "/agent/overview"
    },
    {
      "source": "/features/auto-organization",
      "destination": "/workflows/overview"
    },
    {
      "source": "/integrations/google-drive-import",
      "destination": "/integrations/google-drive"
    },
    {
      "source": "/integrations/onedrive-import",
      "destination": "/integrations/onedrive"
    },
    {
      "source": "/integrations/dropbox-import",
      "destination": "/integrations/dropbox"
